rules_version = '2';

// Pravila poslije Etape 6: XP i statistiku mijenja ISKLJUČIVO server
// (Cloud Functions preko Admin SDK-a, koji zaobilazi ova pravila).
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = korisnik s custom claimom admin:true (postavi-admina.js).
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // -----------------------------------------------------------------------
    // 'users' — profil igrača.
    //
    // XP, statistika, taskovi, bedževi i osvojena kozmetika su ISKLJUČIVO
    // serverski. Klijentu je otvoreno tačno pet polja, i svako od njih je
    // kozmetika bez ijednog XP-a:
    //
    //   displayName, avatar   — osnovni podaci profila
    //   fcmTokens             — push tokeni uređaja (F2.2). Igrač piše samo u
    //                           SVOJ dokument, pa najgore što može je da sebi
    //                           pokvari notifikacije.
    //   notifOn, notifPrefs   — je li pretplaćen i koje tipove poruka želi
    //   (survivalChest je od 30.07.2026. IZBAČEN iz ove liste: kovčeg na
    //    ljestvici Preživljavanja od tada nosi i žetone, pa ga otvara server
    //    kroz claimSurvivalChest. Da je oznaka ostala otvorena klijentu, igrač
    //    bi je mogao vratiti unazad i izvlačiti žetone iznova.)
    //   featuredBadges        — koji se od OSVOJENIH bedževa vide na avataru
    //   cosmetics.frame       — koji se od OSVOJENIH okvira nosi
    // -----------------------------------------------------------------------
    match /users/{userId} {

      // Istaknuti bedževi smiju biti samo stvarno osvojeni (users/{uid}.badges
      // upisuje server) i najviše tri — koliko nosi najviši nivo otključavanja
      // (level 30). Tačan broj mjesta po levelu drži UI (utils/levels.js): level
      // se računa iz XP krive u config/levels, koju pravila ne mogu čitati.
      // Najgore što se može izvući je da igrač na nižem levelu pokaže tri VEĆ
      // OSVOJENA bedža — čista kozmetika.
      function validFeaturedBadges() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['featuredBadges'])
               || (request.resource.data.featuredBadges is list
                   && request.resource.data.featuredBadges.size() <= 3
                   && request.resource.data.featuredBadges
                        .hasOnly(resource.data.get('badges', {}).keys()));
      }

      // Kozmetika ima tri nezavisna mjesta — okvir (dueli), pozadina
      // (Preživljavanje) i aura (XP trka). U svako smije ići samo ukras koji
      // igrač stvarno posjeduje, ili null.
      function slotOk(slot) {
        return request.resource.data.cosmetics.get(slot, null) == null
               || request.resource.data.cosmetics.get(slot, null)
                    in request.resource.data.cosmetics.get('owned', []);
      }

      // Lista osvojenih (cosmetics.owned) mora ostati identična — inače bi si
      // igrač sam dodijelio sve ukrase. Nju puni isključivo server.
      function validCosmetics() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['cosmetics'])
               || (request.resource.data.cosmetics.get('owned', [])
                     == resource.data.get('cosmetics', {}).get('owned', [])
                   && slotOk('ring') && slotOk('background') && slotOk('aura'));
      }

      // Čitanje: svaki prijavljen korisnik (leaderboard i javni profili).
      allow read: if request.auth != null;

      // Kreiranje: samo vlastiti profil, i XP mora krenuti od nule.
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.xp == 0;

      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'avatar',
                                   'featuredBadges', 'cosmetics',
                                   'fcmTokens', 'notifOn', 'notifPrefs'])
                    && validFeaturedBadges()
                    && validCosmetics();

      allow delete: if false;
    }

    // 'questions' — banka pitanja (Modul 3).
    // Čitanje: samo prijavljeni korisnici. Pisanje: NIKO s klijenta —
    // pitanja se uvoze isključivo admin skriptom (scripts/import-questions.js),
    // koja ide preko Admin SDK-a i zaobilazi ova pravila.
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin(); // admin panel; inače uvoz preko Admin SDK-a
    }

    // 'bank' — izvedeni indeks banke pitanja (bank/index): metapodaci svih
    // aktivnih pitanja u jednom dokumentu, iz kojeg server bira pitanja umjesto
    // da skenira cijelu kolekciju. Piše ga ISKLJUČIVO server (Admin SDK
    // zaobilazi pravila, callable adminRebuildBankIndex).
    //
    // Čitanje je otvoreno samo adminu: panel njime provjerava je li njegov
    // localStorage keš banke još svjež. Obični igrač ga ne treba — pitanja mu
    // servira Cloud Function. Ne sadrži tačne odgovore, samo id/points/category.
    match /bank/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // 'config' — konfiguracija igre (XP kriva, prozori turnira i Preživljavanja).
    // Čitanje za prijavljene (kartice eventa čitaju prozor).
    // Pisanje: admin. NAPOMENA — admin panel prozore mijenja preko Cloud
    // Functiona (adminSetTournamentConfig), koji provjerava da je prozor
    // rastuć i loguje izmjenu. Direktan upis s klijenta te provjere zaobilazi;
    // ako se ikad poželi zatvoriti, ovdje se stavi `false` i sve ide kroz
    // funkcije (Admin SDK u skriptama ionako zaobilazi pravila).
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 'tasks' — definicije dnevnih/sedmičnih/mjesečnih taskova (Modul 6).
    // Čitanje za prijavljene; piše admin (panel) ili Admin SDK.
    match /tasks/{taskId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 'badges' — definicije bedževa (achievements).
    // Čitanje za prijavljene; dodjelu (users/{uid}.badges) radi ISKLJUČIVO
    // server (Cloud Functions, awardBadges). Definicije piše admin (panel).
    match /badges/{badgeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // 'questionSecrets' — tačni odgovori i objašnjenja (Etapa 6).
    // Čita ih server (Cloud Functions). Admin ih čita/mijenja iz panela da
    // ispravi pogrešan tačan odgovor; obični klijent NEMA pristup.
    match /questionSecrets/{questionId} {
      allow read, write: if isAdmin();
    }

    // 'quizSessions' — aktivne kviz sesije (Etapa 6). Samo server.
    match /quizSessions/{sessionId} {
      allow read, write: if false;
    }

    // 'survivalRuns' — stanje run-a Preživljavanja (Etapa 8). Samo server;
    // klijent dobija stanje/pitanja preko Cloud Functions (start/submit).
    match /survivalRuns/{uid} {
      allow read, write: if false;
    }

    // 'tournaments' — duel turnir: doc + učesnici + mečevi (bracket).
    // Čitanje za prijavljene (prikaz bracketa/statusa); piše samo server.
    match /tournaments/{tid} {
      allow read: if request.auth != null;
      allow write: if false;
      match /participants/{uid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
      match /matches/{mid} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // 'duelSessions' — aktivni duel (pitanja + odgovori). Samo server.
    match /duelSessions/{sid} {
      allow read, write: if false;
    }

    // 'xpRaces' — rezultati/nagrade XP trke po eventu. Čitanje za prijavljene;
    // piše samo server (finalizacija u tournamentTick).
    match /xpRaces/{key} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // KLANOVI
    //
    // Sve je za klijenta READ-ONLY, svaki upis ide kroz callable funkcije
    // (createClan, joinClan, approveJoinRequest, kickMember, disbandClan …).
    //
    // Zašto pravila ne provjeravaju "level >= 10 za osnivanje": level se izvodi
    // iz XP krive u config/levels, a pravila ne mogu čitati druge dokumente
    // (isto ograničenje već stoji uz featuredBadges gore). Provjera bi ovdje
    // bila lažna sigurnost. Zabrana pisanja je stroža od bilo kojeg uslova koji
    // bi se ovdje mogao napisati — level, limit od 10 članova, uloge i prozor
    // registracije provjerava server, gdje se sve to stvarno može pročitati.
    //
    // Čitanje je otvoreno prijavljenima jer ekran "Pronađi klan" pretražuje
    // klanove direktno iz klijenta (bez Cloud Function poziva po pretrazi).
    // -----------------------------------------------------------------------
    match /clans/{clanId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Denormalizovan lookup "u kojem sam klanu" — piše ga server uz svaku
    // promjenu članstva.
    match /clanMembers/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Rezervacija jedinstvenog imena klana (ID dokumenta = ime malim slovima).
    // Firestore nema jedinstvenost polja, pa se ona pravi ovako: dva upisa
    // istog ID-a ne mogu proći u istoj transakciji. Klijent ovo ne treba čitati.
    match /clanNames/{ime} {
      allow read, write: if false;
    }

    // Sedmična takmičenja klanova: prijave i (kasnije) rezultati.
    match /clanCompetitions/{weekId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /registrations/{clanId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Klanski rat. Čitanje je otvoreno prijavljenima (historija sedmica i
    // parovi), pisanje isključivo server — CP, nagrade i nivoi Okruga se
    // dodjeljuju u Cloud Functions.
    //
    // NAPOMENA: živo bodovanje rata NIJE ovdje nego u RTDB-u (clanWar/*), da
    // jedan XP događaj ne bi značio dodatni Firestore upis po igraču. Klijent
    // te čvorove ne čita direktno — sve ide kroz callable getClanWar — pa RTDB
    // pravila za clanWar/* i clanWarDaily/* mogu ostati zatvorena.
    match /clanWars/{warId} {
      allow read: if request.auth != null;
      allow write: if false;
      match /matches/{matchId} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // 'adminLog' — trag svake radnje iz admin panela. Piše ISKLJUČIVO server
    // (Admin SDK); admin ga smije čitati da vidi šta je i kada mijenjano.
    match /adminLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
