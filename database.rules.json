    ".write": false,
    "leaderboard": {
      "global": {
        ".read": "auth != null",
        ".indexOn": ["xp", "streak"]
      },
      "weekly": {
        "$week": {
          ".read": "auth != null",
          ".indexOn": ["xp"]
        }
      }
    },
    "survival": {
      "$week": {
        ".read": "auth != null",
        ".indexOn": ["streak"]
      }
    },
    "tournament": {
      "$key": {
        ".read": "auth != null",
        ".indexOn": ["xp"]
      }
    }
  }
}
